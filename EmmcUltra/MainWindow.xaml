<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EmmcUltra.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:EmmcUltra.Models"
    xmlns:svc="using:EmmcUltra.Services">

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="460"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== LEFT ===================== -->
        <Grid Grid.Column="0" Padding="8" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Device Information -->
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Device Information" Style="{StaticResource PanelTitle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox Width="240" PlaceholderText="เลือก COM Port"
                      ItemsSource="{x:Bind VM.Ports}"
                      SelectedIndex="{x:Bind VM.PortIndex, Mode=TwoWay}"/>
                        <Button Command="{x:Bind VM.RefreshPortsCommand}" ToolTipService.ToolTip="Refresh ports">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        </Button>
                        <Button MinWidth="130" Content="{x:Bind VM.ConnectButtonText, Mode=OneWay}"
                    Command="{x:Bind VM.ConnectCommand}"/>
                        <FontIcon Glyph="&#xE88E;" FontSize="24" Foreground="{StaticResource OkBrush}"/>
                        <TextBlock VerticalAlignment="Center" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"
                       Text="{x:Bind VM.ConnText, Mode=OneWay}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Tasks + Flash Info -->
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Panel}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="eMMC Partition Tasks" Style="{StaticResource PanelTitle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Style="{StaticResource TaskButton}" Command="{x:Bind VM.IdentifyCommand}" ToolTipService.ToolTip="Identify (CID / EXT_CSD)">
                                <StackPanel Spacing="2">
                                    <FontIcon Glyph="&#xE946;" FontSize="22" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="IDENTIFY" Style="{StaticResource TaskLabel}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TaskButton}" Command="{x:Bind VM.ReadGptCommand}" ToolTipService.ToolTip="Read GPT">
                                <StackPanel Spacing="2">
                                    <FontIcon Glyph="&#xE8FD;" FontSize="22" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="READ GPT" Style="{StaticResource TaskLabel}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TaskButton}" Command="{x:Bind VM.DumpSelectedCommand}" ToolTipService.ToolTip="Read selected → file">
                                <StackPanel Spacing="2">
                                    <FontIcon Glyph="&#xE896;" FontSize="22" Foreground="{StaticResource OkBrush}"/>
                                    <TextBlock Text="READ" Style="{StaticResource TaskLabel}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TaskButton}" Command="{x:Bind VM.WriteSelectedCommand}" ToolTipService.ToolTip="Write file → selected">
                                <StackPanel Spacing="2">
                                    <FontIcon Glyph="&#xE898;" FontSize="22" Foreground="{StaticResource DangerBrush}"/>
                                    <TextBlock Text="WRITE" Style="{StaticResource TaskLabel}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TaskButton}" Command="{x:Bind VM.ToggleSelectAllCommand}" ToolTipService.ToolTip="Select all / none">
                                <StackPanel Spacing="2">
                                    <FontIcon Glyph="&#xE8B3;" FontSize="22"/>
                                    <TextBlock Text="SELECT" Style="{StaticResource TaskLabel}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Style="{StaticResource TaskButton}" Command="{x:Bind VM.DumpAllCommand}" ToolTipService.ToolTip="Dump ALL (แยกไฟล์)">
                                <StackPanel Spacing="2">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="22" Foreground="#F5C542"/>
                                    <TextBlock Text="DUMP ALL" Style="{StaticResource TaskLabel}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TaskButton}" Command="{x:Bind VM.DumpExUserdataCommand}" ToolTipService.ToolTip="Dump EX-Userdata">
                                <StackPanel Spacing="2">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="22" Foreground="#F5C542"/>
                                    <TextBlock Text="EX-USER" Style="{StaticResource TaskLabel}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TaskButton}" Command="{x:Bind VM.BackupBootCommand}" ToolTipService.ToolTip="Backup BOOT1 + BOOT2">
                                <StackPanel Spacing="2">
                                    <FontIcon Glyph="&#xE8F1;" FontSize="22" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="BOOT" Style="{StaticResource TaskLabel}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TaskButton}" Command="{x:Bind VM.ForceWriteGptCommand}" ToolTipService.ToolTip="FORCE WRITE GPT (LBA 0)">
                                <StackPanel Spacing="2">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="22" Foreground="{StaticResource DangerBrush}"/>
                                    <TextBlock Text="FORCE GPT" Style="{StaticResource TaskLabel}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Panel}">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Flash Memory Information" Style="{StaticResource PanelTitle}"/>
                        <TextBlock FontSize="12"><Run Text="Product Name: "/><Run Text="{x:Bind VM.ProductName, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/></TextBlock>
                        <TextBlock FontSize="12"><Run Text="Manufacturer ID: "/><Run Text="{x:Bind VM.Manufacturer, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/></TextBlock>
                        <TextBlock FontSize="12"><Run Text="User Area Capacity: "/><Run Text="{x:Bind VM.Capacity, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/></TextBlock>
                        <TextBlock FontSize="12"><Run Text="Specification Version: eMMC "/><Run Text="{x:Bind VM.SpecVersion, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/></TextBlock>
                        <TextBlock FontSize="12"><Run Text="Manufacturing Date: "/><Run Text="{x:Bind VM.MfgDate, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/></TextBlock>
                        <TextBlock FontSize="12"><Run Text="Boot Partition: "/><Run Text="{x:Bind VM.BootInfo, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/></TextBlock>
                        <TextBlock FontSize="12"><Run Text="BOOT1/2 Size: "/><Run Text="{x:Bind VM.BootSize, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/></TextBlock>
                        <TextBlock FontSize="12"><Run Text="RPMB Size: "/><Run Text="{x:Bind VM.RpmbSize, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/></TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Partitions / Raw / EXT_CSD / Log -->
            <Pivot x:Name="LeftPivot" Grid.Row="2">

                <PivotItem Header="EMMC INFO" Margin="0">
                    <Grid Padding="12" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- สรุปค่าหลัก -->
                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="PRODUCT" FontSize="11" Foreground="#7A7A8C"/>
                                <TextBlock Text="{x:Bind VM.ProductName, Mode=OneWay}" Foreground="#00F0FF" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="MANUFACTURER" FontSize="11" Foreground="#7A7A8C"/>
                                <TextBlock Text="{x:Bind VM.Manufacturer, Mode=OneWay}" Foreground="#00F0FF" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="CAPACITY" FontSize="11" Foreground="#7A7A8C"/>
                                <TextBlock Text="{x:Bind VM.Capacity, Mode=OneWay}" Foreground="#00F0FF" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="3">
                                <TextBlock Text="SPEC" FontSize="11" Foreground="#7A7A8C"/>
                                <TextBlock Text="{x:Bind VM.SpecVersion, Mode=OneWay}" Foreground="#00F0FF" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <TextBlock Text="MFG DATE" FontSize="11" Foreground="#7A7A8C"/>
                                <TextBlock Text="{x:Bind VM.MfgDate, Mode=OneWay}" Foreground="#00F0FF" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="BOOT SIZE" FontSize="11" Foreground="#7A7A8C"/>
                                <TextBlock Text="{x:Bind VM.BootSize, Mode=OneWay}" Foreground="#FCEE0A"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="RPMB SIZE" FontSize="11" Foreground="#7A7A8C"/>
                                <TextBlock Text="{x:Bind VM.RpmbSize, Mode=OneWay}" Foreground="#FCEE0A"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="LIFE A (SLC)" FontSize="11" Foreground="#7A7A8C"/>
                                <TextBlock Text="{x:Bind VM.LifeA, Mode=OneWay}" Foreground="#FCEE0A"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="3">
                                <TextBlock Text="LIFE B (MLC)" FontSize="11" Foreground="#7A7A8C"/>
                                <TextBlock Text="{x:Bind VM.LifeB, Mode=OneWay}" Foreground="#FCEE0A"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="4">
                                <TextBlock Text="PRE-EOL" FontSize="11" Foreground="#7A7A8C"/>
                                <TextBlock Text="{x:Bind VM.PreEol, Mode=OneWay}" Foreground="#FCEE0A"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="RE-IDENTIFY" Command="{x:Bind VM.IdentifyCommand}"/>
                            <Button Content="COPY REPORT" Command="{x:Bind VM.CopyInfoCommand}"/>
                            <TextBlock Text="Decoded per JEDEC JESD84-B51 (eMMC 5.1)" VerticalAlignment="Center" Foreground="#7A7A8C"/>
                        </StackPanel>

                        <!-- หัวตาราง -->
                        <Grid Grid.Row="2" Background="#14141E" Padding="12,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="290"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="GROUP" Foreground="#7A7A8C" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="FIELD" Foreground="#7A7A8C" FontSize="12"/>
                            <TextBlock Grid.Column="2" Text="BYTE" Foreground="#7A7A8C" FontSize="12"/>
                            <TextBlock Grid.Column="3" Text="RAW" Foreground="#7A7A8C" FontSize="12"/>
                            <TextBlock Grid.Column="4" Text="DECODED" Foreground="#7A7A8C" FontSize="12"/>
                        </Grid>

                        <ListView Grid.Row="3" ItemsSource="{x:Bind VM.InfoRows}" SelectionMode="None" Background="#0A0A12">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="22"/>
                                    <Setter Property="Padding" Value="12,1"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="m:InfoRow">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="290"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Group}" Foreground="#FF5CF0" FontFamily="Consolas" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Field}" Foreground="#C8D2E6" FontFamily="Consolas" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Byte}" Foreground="#7A7A8C" FontFamily="Consolas" FontSize="12"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind Raw}" Foreground="#FCEE0A" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind Value}" Foreground="#00F0FF" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </PivotItem>


                <PivotItem Header="Partitions" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="PART" Style="{StaticResource ColHeader}"/>
                            <TextBlock Grid.Column="2" Text="Partition Name" Style="{StaticResource ColHeader}"/>
                            <TextBlock Grid.Column="3" Text="Filename" Style="{StaticResource ColHeader}"/>
                            <TextBlock Grid.Column="4" Text="Block Address" Style="{StaticResource ColHeader}"/>
                            <TextBlock Grid.Column="5" Text="Size" Style="{StaticResource ColHeader}"/>
                            <TextBlock Grid.Column="6" Text="Type" Style="{StaticResource ColHeader}"/>
                            <TextBlock Grid.Column="7" Text="Status" Style="{StaticResource ColHeader}"/>
                        </Grid>

                        <ListView Grid.Row="1" ItemsSource="{x:Bind VM.Partitions}"
                      SelectionMode="Extended" DoubleTapped="PartList_DoubleTapped">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="26"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="m:PartitionEntry">
                                    <Grid Height="26">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="230"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="230"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox MinWidth="0" Padding="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind PartLabel}" Style="{StaticResource Cell}" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Name}" Style="{StaticResource Cell}"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind FileName, Mode=OneWay}" Style="{StaticResource Cell}" Foreground="{StaticResource DimBrush}"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind LbaHex}" Style="{StaticResource Cell}" FontFamily="Consolas"/>
                                        <TextBlock Grid.Column="5" Text="{x:Bind SizeText}" Style="{StaticResource Cell}"/>
                                        <TextBlock Grid.Column="6" Text="{x:Bind Type}" Style="{StaticResource Cell}"/>
                                        <TextBlock Grid.Column="7" Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource Cell}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </PivotItem>

                <PivotItem x:Name="RawHexTab" Header="RAW / HEX" Margin="0">
                    <Grid Padding="12" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- ลำดับต้องตรงกับ enum HwPart -->
                            <ComboBox Header="PARTITION" HorizontalAlignment="Stretch"
                      SelectedIndex="{x:Bind VM.RawPartIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="USER"/>
                                <ComboBoxItem Content="BOOT1"/>
                                <ComboBoxItem Content="BOOT2"/>
                                <ComboBoxItem Content="RPMB"/>
                            </ComboBox>
                            <TextBox Grid.Column="1" Header="START LBA (dec / 0x..)" FontFamily="Consolas"
                     Text="{x:Bind VM.RawStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="2" Header="COUNT" FontFamily="Consolas"
                     Text="{x:Bind VM.RawCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                <Button Content="PEEK" Command="{x:Bind VM.PeekCommand}"/>
                                <Button Content="READ RANGE → FILE" Command="{x:Bind VM.ReadRangeCommand}"/>
                                <Button Content="WRITE FILE @ LBA" Command="{x:Bind VM.WriteAtLbaCommand}"/>
                            </StackPanel>

                            <Button Grid.Column="5" Content="READ EXT_CSD" VerticalAlignment="Bottom"
                    Command="{x:Bind VM.ReadExtCsdCommand}"/>
                        </Grid>

                        <!-- Hex (ซ้าย) + ASCII (ขวา) ในบรรทัดเดียวกัน -->
                        <TextBox Grid.Row="1" Text="{x:Bind VM.HexView, Mode=OneWay}"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" IsSpellCheckEnabled="False"
                 FontFamily="Consolas" FontSize="13" Foreground="#00F0FF" Background="#05050A" BorderBrush="#3A3A12"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </PivotItem>
                
            </Pivot>
        </Grid>

        <!-- ===================== ICON RAIL ===================== -->
        <StackPanel Grid.Column="1" Spacing="8" Padding="6,8" Background="{StaticResource RailBrush}">
            <Button Style="{StaticResource RailButton}" Command="{x:Bind VM.IdentifyCommand}" ToolTipService.ToolTip="Identify">
                <FontIcon Glyph="&#xE72C;" FontSize="26" Foreground="#F5A623"/>
            </Button>
            <Button Style="{StaticResource RailButton}" Tag="0" Click="Nav_Click" ToolTipService.ToolTip="eMMC">
                <FontIcon Glyph="&#xE950;" FontSize="26" Foreground="{StaticResource AccentBrush}"/>
            </Button>
            <Button Style="{StaticResource RailButton}" Tag="1" Click="Nav_Click" ToolTipService.ToolTip="Health / Boot">
                <FontIcon Glyph="&#xE95E;" FontSize="26" Foreground="{StaticResource OkBrush}"/>
            </Button>
            <Button Style="{StaticResource RailButton}" Tag="log" Click="Nav_Click" ToolTipService.ToolTip="Log">
                <FontIcon Glyph="&#xE81C;" FontSize="26"/>
            </Button>
        </StackPanel>

        <!-- ===================== RIGHT PANEL ===================== -->
        <Grid Grid.Column="2" Padding="8" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Panel}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE950;" FontSize="36" Foreground="{StaticResource AccentBrush}"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Bind VM.ProductName, Mode=OneWay}" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Foreground="{StaticResource DimBrush}" FontStyle="Italic"><Run Text="eMMC "/><Run Text="{x:Bind VM.SpecVersion, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="eMMC Tools" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     FontSize="22" FontWeight="Bold" FontStyle="Italic" Foreground="{StaticResource AccentBrush}"/>
                </Grid>
            </Border>

            <Pivot x:Name="RightPivot" Grid.Row="1">
                <PivotItem Header="eMMC" Margin="0">
                    <ScrollViewer>
                        <StackPanel Spacing="10" Padding="0,8">
                            <Border Style="{StaticResource Panel}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Connection Parameters" Style="{StaticResource PanelTitle}"/>
                                    <Grid ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="CLKDIV:" Style="{StaticResource Key}"/>
                                        <NumberBox Grid.Column="1" Minimum="0" Maximum="1023" SpinButtonPlacementMode="Compact"
                               Value="{x:Bind VM.ClkDiv, Mode=TwoWay}"/>
                                        <TextBlock Grid.Row="1" Text="Bus Width:" Style="{StaticResource Key}"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                              SelectedIndex="{x:Bind VM.BusIndex, Mode=TwoWay}">
                                            <x:String>1-BIT</x:String>
                                            <x:String>4-BIT</x:String>
                                            <x:String>8-BIT</x:String>
                                        </ComboBox>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="APPLY CLK" Command="{x:Bind VM.ApplyClockCommand}"/>
                                        <Button Content="IDENTIFY" Command="{x:Bind VM.IdentifyCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Panel}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="RAW Access" Style="{StaticResource PanelTitle}"/>
                                    <Grid ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="HW Part:" Style="{StaticResource Key}"/>
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                              SelectedIndex="{x:Bind VM.RawPartIndex, Mode=TwoWay}">
                                            <x:String>USER</x:String>
                                            <x:String>BOOT1</x:String>
                                            <x:String>BOOT2</x:String>
                                            <x:String>RPMB</x:String>
                                        </ComboBox>
                                        <TextBlock Grid.Row="1" Text="Start LBA:" Style="{StaticResource Key}"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" FontFamily="Consolas"
                             Text="{x:Bind VM.RawStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="2" Text="Count:" Style="{StaticResource Key}"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" FontFamily="Consolas"
                             Text="{x:Bind VM.RawCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="PEEK (HEX)" Command="{x:Bind VM.PeekCommand}"/>
                                        <Button Content="READ RANGE → FILE" Command="{x:Bind VM.ReadRangeCommand}"/>
                                    </StackPanel>
                                    <Button Content="WRITE FILE @ LBA" Style="{StaticResource DangerButton}"
                          Command="{x:Bind VM.WriteAtLbaCommand}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <PivotItem Header="Health / Boot" Margin="0">
                    <StackPanel Spacing="10" Padding="0,8">
                        <Border Style="{StaticResource Panel}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Device Health (EXT_CSD)" Style="{StaticResource PanelTitle}"/>
                                <TextBlock FontSize="12"><Run Text="Life Time Est. A [268]: " Foreground="{StaticResource DimBrush}"/><Run Text="{x:Bind VM.LifeA, Mode=OneWay}"/></TextBlock>
                                <TextBlock FontSize="12"><Run Text="Life Time Est. B [269]: " Foreground="{StaticResource DimBrush}"/><Run Text="{x:Bind VM.LifeB, Mode=OneWay}"/></TextBlock>
                                <TextBlock FontSize="12"><Run Text="Pre-EOL Info [267]: " Foreground="{StaticResource DimBrush}"/><Run Text="{x:Bind VM.PreEol, Mode=OneWay}"/></TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Boot Partitions" Style="{StaticResource PanelTitle}"/>
                                <TextBlock FontSize="12"><Run Text="Boot Enabled: " Foreground="{StaticResource DimBrush}"/><Run Text="{x:Bind VM.BootInfo, Mode=OneWay}"/></TextBlock>
                                <TextBlock FontSize="12"><Run Text="BOOT1/2 Size: " Foreground="{StaticResource DimBrush}"/><Run Text="{x:Bind VM.BootSize, Mode=OneWay}"/></TextBlock>
                                <Button Content="BACKUP BOOT1 + BOOT2" Command="{x:Bind VM.BackupBootCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </PivotItem>
            </Pivot>
        </Grid>

        <!-- ===================== PROGRESS ===================== -->
        <Grid Grid.Row="1" Grid.ColumnSpan="3" Padding="8,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <ProgressBar MinHeight="20" Maximum="100" CornerRadius="3"
                     Foreground="{StaticResource StatusBarBrush}" Background="#2B3138"
                     Value="{x:Bind VM.ProgressValue, Mode=OneWay}"/>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                   Text="{x:Bind VM.ProgressText, Mode=OneWay}"/>
            </Grid>
            <Button Grid.Column="1" Content="ABORT" Style="{StaticResource DangerButton}"
              Command="{x:Bind VM.AbortCommand}"/>
        </Grid>

        <!-- ===================== STATUS BAR ===================== -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Background="{StaticResource StatusBarBrush}" Padding="10,3" ColumnSpacing="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="12" Text="{x:Bind VM.StatAddress, Mode=OneWay}"/>
            <TextBlock Grid.Column="1" FontSize="12" Text="{x:Bind VM.StatSize, Mode=OneWay}"/>
            <TextBlock Grid.Column="2" FontSize="12" Text="{x:Bind VM.StatSpeed, Mode=OneWay}"/>
            <TextBlock Grid.Column="3" FontSize="12" Text="{x:Bind VM.StatEta, Mode=OneWay}"/>
            <TextBlock Grid.Column="4" FontSize="12" Text="{x:Bind VM.StatMem, Mode=OneWay}"/>
        </Grid>
    
    
        <Border Grid.Row="2" Background="#05050A" BorderBrush="#3A3A12" BorderThickness="0,1,0,0" Padding="10,6,10,8">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ADVANCED LOG" FontWeight="Bold" Foreground="#FCEE0A" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="#1A1A22" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind VM.DebugBadge}" FontSize="11" Foreground="#B07CFF"/>
                    </Border>
                    <CheckBox Grid.Column="2" Content="Append log to file" MinWidth="0"
                          IsChecked="{x:Bind VM.LogToFile, Mode=TwoWay}"/>
                    <TextBox Grid.Column="3" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"
                         Text="{x:Bind VM.LogFilePath, Mode=TwoWay}"
                         IsEnabled="{x:Bind VM.LogToFile, Mode=OneWay}"/>
                    <Button Grid.Column="4" Content="BROWSE..." Command="{x:Bind VM.BrowseLogFileCommand}"/>
                    <CheckBox Grid.Column="5" Content="Auto-scroll" MinWidth="0"
                          IsChecked="{x:Bind VM.LogAutoScroll, Mode=TwoWay}"/>
                    <Button Grid.Column="6" Content="COPY" Command="{x:Bind VM.CopyLogCommand}"/>
                    <Button Grid.Column="7" Content="CLEAR" Command="{x:Bind VM.ClearLogCommand}"/>
                </Grid>

                <ListView x:Name="LogList" Grid.Row="1" ItemsSource="{x:Bind VM.LogLines}"
                      SelectionMode="None" Background="#000000" BorderBrush="#1E1E2A" BorderThickness="1">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="18"/>
                            <Setter Property="Padding" Value="8,0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="svc:LogLine">
                            <TextBlock Text="{x:Bind Text}" Foreground="{x:Bind Brush}"
                                   FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Window>